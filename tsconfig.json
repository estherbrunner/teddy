{
  // Type-checks everything Teddy owns (src/, its host check, its config).
  // Emit is configured in tsconfig.build.json; the cockpit (DOM) in
  // tsconfig.cockpit.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "checks/**/*.ts", "teddy.config.ts"],
  "exclude": ["src/cockpit"]
}
